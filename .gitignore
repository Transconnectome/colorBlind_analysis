*.pickle

## Log directories
logs/
" logs"/
logs_backup/

## Previous results in main dir
/results/

## All results directories under analysis/* (including subdirectories)
analysis/**/results/
# But allow doc/manifest files inside analysis/**/results dirs to be tracked
!analysis/**/results/
!analysis/**/results/**/
!analysis/**/results/README.md
!analysis/**/results/MANIFEST.md
!analysis/**/results/**/README.md
!analysis/**/results/loss_inventory.md
!analysis/**/results/loss_inventory.csv
# Re-ignore data file types inside the now-allowed dirs (track only docs)
analysis/**/results/**/*.json
analysis/**/results/**/*.npy
# Allow primary preprocessed amplitude data (shared via git / git-lfs for onboarding)
!analysis/phase1_procrustes_decoding/results/full_dataset_C010/**/*.npy
!analysis/phase1_procrustes_decoding/results/visualization/full_dataset_C010_with_residuals/**/*.npy
analysis/**/results/**/*.npz
analysis/**/results/**/*.png
analysis/**/results/**/*.jpg
analysis/**/results/**/*.pdf
analysis/**/results/**/*.svg
analysis/**/results/**/*.txt
analysis/**/results/**/*.log
analysis/**/results/**/*.html
analysis/**/results/**/*.tsv
analysis/**/results/**/*.pkl
analysis/**/results/**/*.h5
analysis/**/results/**/*.csv
analysis/**/results/**/*.py
analysis/**/results/**/*.sbatch
analysis/**/results/**/*.sh
# Re-allow the specific whitelist (loss_inventory.csv — primary inventory artifact)
!analysis/**/results/loss_inventory.csv
!analysis/**/results/inventory/loss_inventory.csv
!analysis/**/results/inventory/loss_inventory.md

