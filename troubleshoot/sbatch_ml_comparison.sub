#!/bin/bash
#SBATCH -J ml_compare
#SBATCH -c 8
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH -t 3:00:00
#SBATCH -o logs/ml_compare_%j.out
#SBATCH -e logs/ml_compare_%j.err
#SBATCH --nodelist=node3

# Navigate to project directory
cd /scratch/connectome/haba6030/colorBlind

# Load conda environment
source ~/.bashrc
conda activate nilearn

# Check GPU availability
echo "Checking GPU availability..."
nvidia-smi
echo ""

# Run comparison for each ROI
echo "Starting ML/DL forward model comparison..."

for ROI in V1 V2 V3 hV4 BrainMask
do
    echo ""
    echo "========================================"
    echo "Testing ROI: $ROI"
    echo "========================================"

    # Test all models for this ROI
    python compare_forward_models.py --roi $ROI --models ridge mlp attention

    if [ $? -eq 0 ]; then
        echo "SUCCESS: $ROI comparison complete"
    else
        echo "ERROR: $ROI comparison failed"
    fi
done

echo ""
echo "All comparisons complete!"
