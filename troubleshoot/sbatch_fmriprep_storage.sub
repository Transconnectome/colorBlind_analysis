#!/bin/bash
#SBATCH -J fprep_full
#SBATCH -c 8
#SBATCH --mem=32G
#SBATCH -t 48:00:00
#SBATCH -o logs/fprep_full_%j.out
#SBATCH -e logs/fprep_full_%j.err
#SBATCH --nodelist=node2

# Singularity 절대경로 지정 (which singularity 결과로 교체)
APPTAINER=/usr/local/bin/singularity

# 출력/작업 폴더: storage 디렉토리 사용
OUT_DIR=/storage/connectome/haba6030/fmriprep_out
WORK_DIR=/storage/connectome/haba6030/fmriprep_work
mkdir -p "$OUT_DIR" "$WORK_DIR"

echo "========================================="
echo "fMRIPrep Full Preprocessing (anat + func)"
echo "========================================="
echo "Output directory: $OUT_DIR"
echo "Work directory:   $WORK_DIR"
echo "========================================="
echo

# 필수 경로 기본값 (필요하면 sbatch 전에 export로 덮어쓰세요)
DS_LOCALIZER=${DS_LOCALIZER:-/scratch/connectome/haba6030/colorBlind/colorBlind_dataOct}
FS_LICENSE=${FS_LICENSE:-$HOME/fs_license.txt}
FMRIprep_IMG=${FMRIprep_IMG:-$HOME/fmriprep-23.2.3.sif}

# 경로나 파일이 실제로 존재하는지 간단히 확인해 조기 실패 유도
if [ ! -d "$DS_LOCALIZER" ]; then
  echo "Dataset path not found: $DS_LOCALIZER" >&2
  exit 1
fi
if [ ! -f "$FS_LICENSE" ]; then
  echo "FreeSurfer license not found: $FS_LICENSE" >&2
  exit 1
fi
if [ ! -f "$FMRIprep_IMG" ]; then
  echo "fMRIPrep image not found: $FMRIprep_IMG" >&2
  exit 1
fi

# 처리할 참가자 ID 목록 (공백으로 구분). 필요 시 sbatch 전에 export PARTICIPANT_LABELS="sub-05 sub-06" 형태로 덮어쓰세요.
PARTICIPANT_LABELS=${PARTICIPANT_LABELS:-"sub-02 sub-03 sub-04"}
IFS=' ' read -r -a PARTICIPANTS <<< "$PARTICIPANT_LABELS"
if [ ${#PARTICIPANTS[@]} -eq 0 ]; then
  echo "No participant labels provided. Set PARTICIPANT_LABELS before submitting the job." >&2
  exit 1
fi

echo "Processing participants: ${PARTICIPANTS[@]}"
echo "Start time: $(date)"
echo

# 실행 - Full preprocessing (anatomical + functional)
# --anat-only 제거하여 functional data도 처리
"$APPTAINER" run --cleanenv \
  -B "$DS_LOCALIZER":/data:ro \
  -B "$OUT_DIR":/out \
  -B "$WORK_DIR":/work \
  "$FMRIprep_IMG" \
  /data /out participant \
  --participant-label "${PARTICIPANTS[@]}" \
  --fs-license-file $FS_LICENSE \
  --output-spaces T1w fsaverage MNI152NLin2009cAsym:res-2 \
  --bold2t1w-dof 6 \
  --use-syn-sdc \
  --n_cpus ${SLURM_CPUS_PER_TASK:-8} \
  --mem_mb 32000 \
  -w /work \
  --write-graph \
  --skip-bids-validation

EXIT_CODE=$?

echo
echo "========================================="
echo "fMRIPrep completed!"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================="
echo
echo "Output location:"
echo "  Anatomical: $OUT_DIR/sub-*/anat/"
echo "  Functional: $OUT_DIR/sub-*/func/"
echo "  Figures:    $OUT_DIR/sub-*/figures/"
echo "========================================="

exit $EXIT_CODE
